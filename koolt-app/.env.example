# PostgreSQL. En Vercel lo inyecta la integración de Neon (Marketplace).
# En local copie este archivo a .env (no .env.local: la CLI de Prisma y la
# siembra solo leen .env), o bájelo con: npx vercel env pull .env
DATABASE_URL="postgres://usuario:clave@host/basedatos?sslmode=require"

# Inicio de sesión. En Vercel los inyecta la integración de Clerk (Marketplace).
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Opcional: correos que entran como administración sin esperar aprobación,
# separados por coma. Si se deja vacío, la primera cuenta registrada lo es.
KOOLT_ADMIN_EMAILS=""
